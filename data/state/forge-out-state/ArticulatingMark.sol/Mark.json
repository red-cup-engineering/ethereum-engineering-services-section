)":"28379ae0"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.28+commit.7893614a\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[],\"name\":\"EmptySurface\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"mark\",\"type\":\"bytes32\"}],\"name\":\"MarkAlreadyAdmitted\",\"type\":\"error\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"mark\",\"type\":\"bytes32\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"admitter\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"bytes\",\"name\":\"surface\",\"type\":\"bytes\"}],\"name\":\"MarkAdmitted\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"bytes\",\"name\":\"surface\",\"type\":\"bytes\"}],\"name\":\"admit\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"id\",\"type\":\"bytes32\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"name\":\"admitted\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes\",\"name\":\"surface\",\"type\":\"bytes\"}],\"name\":\"markId\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"pure\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"The event log is the append-only admission spine (the truth order);      storage holds one bit per mark so that a second admission is refused      rather than double-witnessed, keeping state the exact fold of the log.      Admission is ungated: charge, authority, and payment are relational      data and enter only at later rungs \\u2014 past Mark and Articulating,      nothing is free.\",\"kind\":\"dev\",\"methods\":{},\"title\":\"Mark\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"notice\":\"The primitive admission of the Semiotic Exchange Chain. A mark is         its surface and nothing else: nullary, chargeless, unowned, and         unkinded. Kind (token | claim) is positional and belongs to the         utterance that positions the mark, never to the mark itself.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"lib/solidity/Mark.sol\":\"Mark\"},\"evmVersion\":\"prague\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[],\"viaIR\":true},\"sources\":{\"lib/solidity/Mark.sol\":{\"keccak256\":\"0xcb5ee0ebf5aaa8b0279d9de64184b0e306b3154236f4eafaf735269cb1e86e77\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://7c4912964a116b7be0de5bf0021c05443c6135b3692d205a1fc8a7b17b0bf971\",\"dweb:/ipfs/QmSmec9XAFRgG6411BxxseYCbum1kN4ZkYm6DXAzabawwp\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.28+commit.7893614a"},"language":"Solidity","output":{"abi":[{"inputs":[],"type":"error","name":"EmptySurface"},{"inputs":[{"internalType":"bytes32","name":"mark","type":"bytes32"}],"type":"error","name":"MarkAlreadyAdmitted"},{"inputs":[{"internalType":"bytes32","name":"mark","type":"bytes32","indexed":true},{"internalType":"address","name":"admitter","type":"address","indexed":true},{"internalType":"bytes","name":"surface","type":"bytes","indexed":false}],"type":"event","name":"MarkAdmitted","anonymous":false},{"inputs":[{"internalType":"bytes","name":"surface","type":"bytes"}],"stateMutability":"nonpayable","type":"function","name":"admit","outputs":[{"internalType":"bytes32","name":"id","type":"bytes32"}]},{"inputs":[{"internalType":"bytes32","name":"","type":"bytes32"}],"stateMutability":"view","type":"function","name":"admitted","outputs":[{"internalType":"bool","name":"","type":"bool"}]},{"inputs":[{"internalType":"bytes","name":"surface","type":"bytes"}],"stateMutability":"pure","type":"function","name":"markId","outputs":[{"internalType":"bytes32","name":"","type":"bytes32"}]}],"devdoc":{"kind":"dev","methods":{},"version":1},"userdoc":{"kind":"user","methods":{}