      "output": "dist/articulating/ArticulationCell.json"
    },
    {
      "source": "src/Articulating.sol",
      "name": "Articulating",
      "output": "dist/articulating/Articulating.json"
    },
    {
      "source": "src/ArticulatingMark.sol",
      "name": "Mark",
      "output": "dist/articulating/Mark.json"
    },
    {
      "source": "src/ArticulatingUtterance.sol",
      "name": "Utterance",
      "output": "dist/articulating/Utterance.json"
    }
  ]
}
