{
  "type": "ArticulatingSolidityCompilation",
  "version": 1,
  "compiler": "solc@0.8.28",
  "settings": {
    "optimizer": {
      "enabled": true,
      "runs": 200
    },
    "viaIR": true,
    "evmVersion": "cancun"
  },
  "contracts": [
    {
      "source": "src/ArticulationCell.sol",
