[Unit]
Description=Union alpha chain Besu node (chain ID from the network formation genesis)
Wants=network-online.target
After=network-online.target
ConditionPathExists=%h/.config/red-cup-engineering/alpha-chain-5615610.env
ConditionPathExists=%h/.local/share/red-cup-engineering/alpha-chain-5615610/formation/network/genesis.json

[Service]
Type=simple
EnvironmentFile=%h/.config/red-cup-engineering/alpha-chain-5615610.env
Environment=JAVA_HOME=%h/.local/share/jvm/java-25-openjdk-amd64
Environment="BESU_OPTS=-Djava.net.preferIPv4Stack=true -Xms128m -Xmx512m -XX:+ExitOnOutOfMemoryError"
ExecStart=%h/.local/share/besu/26.7.0/bin/besu --data-path=%h/.local/share/red-cup-engineering/alpha-chain-5615610/node --genesis-file=%h/.local/share/red-cup-engineering/alpha-chain-5615610/formation/network/genesis.json --network-id=5615610 --profile=ENTERPRISE --sync-mode=FULL --version-compatibility-protection=true --p2p-host=${P2P_HOST} --p2p-interface=${P2P_INTERFACE} --p2p-port=30303 --rpc-http-enabled=true --rpc-http-host=${RPC_HOST} --rpc-http-port=8561 --rpc-http-api=ETH,NET,WEB3,QBFT,ADMIN --rpc-ws-enabled=false --graphql-http-enabled=false --host-allowlist=localhost,127.0.0.1,${RPC_HOST} --metrics-enabled=true --metrics-host=127.0.0.1 --metrics-port=9545 --min-gas-price=${MIN_GAS_PRICE} --bootnodes=${BOOTNODES}
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=45s
LimitNOFILE=65536
MemoryMax=900M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/red-cup-engineering/alpha-chain-5615610/node
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
UMask=0077

[Install]
WantedBy=default.target
