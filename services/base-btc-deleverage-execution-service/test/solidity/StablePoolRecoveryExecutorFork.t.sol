pragma solidity ^0.8.28;
import "../../contracts/StablePoolRecoveryExecutor.sol";
import "./MoonwellHealthAssertions.sol";
interface Vm { function prank(address) external; function expectRevert() external; function createSelectFork(string calldata,uint256) external returns(uint256); function envOr(string calldata,bool) external returns(bool); function envOr(string calldata,string calldata) external returns(string memory); function envOr(string calldata,uint256) external returns(uint256); function envAddress(string calldata) external returns(address); }
contract MockToken {
    enum Mode { Normal, FalseReturn, NoReturn, RevertCall, Fee, Reenter }
    mapping(address => uint256) public b; Mode public mode; uint256 public fee; StablePoolRecoveryExecutor public target; bool public reentryAttempted;
    function setMode(Mode value,uint256 fee_) external {mode=value;fee=fee_;} function setTarget(StablePoolRecoveryExecutor value) external {target=value;} function mint(address to,uint256 amount) external {b[to]+=amount;} function balanceOf(address who) external view returns(uint256){return b[who];} function allowance(address,address) external pure returns(uint256){return type(uint256).max;} function approve(address,uint256) external pure returns(bool){return true;} function transferFrom(address from,address to,uint256 amount) external returns(bool){return _move(from,to,amount);} function transfer(address to,uint256 amount) external returns(bool){return _move(msg.sender,to,amount);}
    function _move(address from,address to,uint256 amount) private returns(bool) { if(mode==Mode.RevertCall)revert("token revert");if(mode==Mode.FalseReturn)return false;if(mode==Mode.Reenter){reentryAttempted=true;try target.execute(){}catch{}}require(b[from]>=amount,"balance");b[from]-=amount;b[to]+=amount-(mode==Mode.Fee?fee:0);if(mode==Mode.NoReturn)assembly{return(0,0)}return true; }
}
contract MockFactory {address public pool;function setPool(address value)external{pool=value;}function getPool(address,address,bool)external view returns(address){return pool;}}
contract MockPool is MockToken {address public factory;address public t0;address public t1;bool public stable;uint256 public burn0;uint256 public burn1;uint256 public quote;bool public reenter;bool public poolReentryAttempted;constructor(address f,address a,address b_){factory=f;t0=a;t1=b_;stable=true;}function configure(uint256 a,uint256 b_,uint256 q)external{burn0=a;burn1=b_;quote=q;}function topology(address f,address a,address b_,bool s)external{factory=f;t0=a;t1=b_;stable=s;}function setReenter(StablePoolRecoveryExecutor x)external{reenter=true;target=x;}function token0()external view returns(address){return t0;}function token1()external view returns(address){return t1;}function burn(address to)external returns(uint256,uint256){if(reenter){poolReentryAttempted=true;try target.execute(){}catch{}}b[address(this)]=0;MockToken(t0).mint(to,burn0);MockToken(t1).mint(to,burn1);return(burn0,burn1);}function getAmountOut(uint,address)external view returns(uint256){return quote;}function swap(uint,uint amountOut,address to,bytes calldata)external{if(reenter){poolReentryAttempted=true;try target.execute(){}catch{}}MockToken(t1).mint(to,amountOut);}}
interface IRealPool { function factory() external view returns(address); function token0() external view returns(address); function token1() external view returns(address); function stable() external view returns(bool); function totalSupply() external view returns(uint); function balanceOf(address) external view returns(uint); function approve(address,uint) external returns(bool); function getAmountOut(uint,address) external view returns(uint); } interface IRealReward {function balanceOf(address)external view returns(uint);function withdraw(uint)external;} interface IRealVault {function balanceOf(address)external view returns(uint);function withdrawAll()external;} interface IRealMarket {function borrowBalanceStored(address)external view returns(uint);function borrowBalanceCurrent(address)external returns(uint);function repayBorrow(uint)external returns(uint);}
contract StablePoolRecoveryExecutorForkTest {
    Vm constant vm=Vm(address(uint160(uint256(keccak256("hevm cheat code"))))); struct Route{MockToken a;MockToken b;MockFactory f;MockPool p;StablePoolRecoveryExecutor x;}
    function route()internal returns(Route memory r){r.a=new MockToken();r.b=new MockToken();r.f=new MockFactory();r.p=new MockPool(address(r.f),address(r.a),address(r.b));r.f.setPool(address(r.p));r.p.configure(10,20,15);r.a.mint(address(this),5);r.b.mint(address(this),9);r.p.mint(address(this),7);r.x=new StablePoolRecoveryExecutor(address(this),address(0xBEEF),address(r.f),address(r.p),address(r.a),address(r.b),true,7,5,9,10,20,44,44,block.timestamp+1,address(r.f).codehash,address(r.p).codehash,address(r.a).codehash,address(r.b).codehash);}
    function unchanged(Route memory r)internal view{require(!r.x.used(),"used persisted");require(r.a.b(address(this))==5&&r.b.b(address(this))==9&&r.p.b(address(this))==7,"source changed");}
    function testSuccessfulRoutePullsExactlyAndExcludesDonations()external{Route memory r=route();r.a.mint(address(r.x),3);r.b.mint(address(r.x),4);r.p.mint(address(r.x),2);uint before=r.b.b(address(0xBEEF));r.x.execute();require(r.a.b(address(this))==0&&r.b.b(address(this))==0&&r.p.b(address(this))==0,"exact source pulls");require(r.b.b(address(0xBEEF))==before+44,"recipient exact delta");require(r.a.b(address(r.x))==3&&r.b.b(address(r.x))==4&&r.p.b(address(r.x))==2,"donated dust");require(r.x.used(),"used");}
    function testWrongCallerExpiryAndReplayLeaveNoEffects()external{Route memory r=route();vm.prank(address(0xCAFE));vm.expectRevert();r.x.execute();unchanged(r);r.x.execute();vm.expectRevert();r.x.execute();require(r.x.used(),"replay");Route memory e=route();e.x=new StablePoolRecoveryExecutor(address(this),address(1),address(e.f),address(e.p),address(e.a),address(e.b),true,7,5,9,10,20,44,44,0,address(e.f).codehash,address(e.p).codehash,address(e.a).codehash,address(e.b).codehash);vm.expectRevert();e.x.execute();unchanged(e);}
    function testConstructorRejectsBadBoundsAndNonContracts()external{Route memory r=route();vm.expectRevert();new StablePoolRecoveryExecutor(address(this),address(1),address(r.f),address(r.p),address(r.a),address(r.b),true,0,0,0,1,1,1,1,1,address(r.f).codehash,address(r.p).codehash,address(r.a).codehash,address(r.b).codehash);vm.expectRevert();new StablePoolRecoveryExecutor(address(this),address(1),address(r.f),address(r.p),address(r.a),address(r.b),true,1,0,0,1,1,2,1,1,address(r.f).codehash,address(r.p).codehash,address(r.a).codehash,address(r.b).codehash);vm.expectRevert();new StablePoolRecoveryExecutor(address(this),address(1),address(0x1234),address(r.p),address(r.a),address(r.b),true,1,0,0,1,1,1,1,1,bytes32(uint(1)),address(r.p).codehash,address(r.a).codehash,address(r.b).codehash);}
    function testCodehashAndEveryTopologyBindingRefuseWithFullRevert()external{Route memory r=route();StablePoolRecoveryExecutor bad=new StablePoolRecoveryExecutor(address(this),address(1),address(r.f),address(r.p),address(r.a),address(r.b),true,7,5,9,10,20,44,44,1,bytes32(uint(1)),address(r.p).codehash,address(r.a).codehash,address(r.b).codehash);vm.expectRevert();bad.execute();r.f.setPool(address(0xCAFE));vm.expectRevert();r.x.execute();unchanged(r);r.f.setPool(address(r.p));r.p.topology(address(0xCAFE),address(r.a),address(r.b),true);vm.expectRevert();r.x.execute();unchanged(r);r.p.topology(address(r.f),address(r.b),address(r.a),true);vm.expectRevert();r.x.execute();unchanged(r);r.p.topology(address(r.f),address(r.a),address(r.b),false);vm.expectRevert();r.x.execute();unchanged(r);}
    function testFalseNoReturnRevertingAndFeeTokensRefuseWithoutPersisting()external{Route memory r=route();r.a.setMode(MockToken.Mode.FalseReturn,0);vm.expectRevert();r.x.execute();unchanged(r);r=route();r.a.setMode(MockToken.Mode.NoReturn,0);r.x.execute();require(r.x.used(),"no return accepted");r=route();r.a.setMode(MockToken.Mode.RevertCall,0);vm.expectRevert();r.x.execute();unchanged(r);r=route();r.a.setMode(MockToken.Mode.Fee,1);vm.expectRevert();r.x.execute();unchanged(r);r=route();r.b.setMode(MockToken.Mode.Fee,1);vm.expectRevert();r.x.execute();unchanged(r);r=route();r.p.setMode(MockToken.Mode.Fee,1);vm.expectRevert();r.x.execute();unchanged(r);}
    function testBurnAndTotalRepayBoundsRollBackEveryAsset()external{Route memory r=route();StablePoolRecoveryExecutor highBurn=new StablePoolRecoveryExecutor(address(this),address(1),address(r.f),address(r.p),address(r.a),address(r.b),true,7,5,9,11,20,1,100,block.timestamp+1,address(r.f).codehash,address(r.p).codehash,address(r.a).codehash,address(r.b).codehash);vm.expectRevert();highBurn.execute();require(!highBurn.used(),"burn flag");unchanged(r);StablePoolRecoveryExecutor lowTotal=new StablePoolRecoveryExecutor(address(this),address(1),address(r.f),address(r.p),address(r.a),address(r.b),true,7,5,9,10,20,45,100,block.timestamp+1,address(r.f).codehash,address(r.p).codehash,address(r.a).codehash,address(r.b).codehash);vm.expectRevert();lowTotal.execute();require(!lowTotal.used(),"min flag");unchanged(r);StablePoolRecoveryExecutor highTotal=new StablePoolRecoveryExecutor(address(this),address(1),address(r.f),address(r.p),address(r.a),address(r.b),true,7,5,9,10,20,1,43,block.timestamp+1,address(r.f).codehash,address(r.p).codehash,address(r.a).codehash,address(r.b).codehash);vm.expectRevert();highTotal.execute();require(!highTotal.used(),"max flag");unchanged(r);}
    function testRecipientFeeRefusalRollsBackAfterTheSwap()external{Route memory r=route();StablePoolRecoveryExecutor onlyOutput=new StablePoolRecoveryExecutor(address(this),address(0xBEEF),address(r.f),address(r.p),address(r.a),address(r.b),true,7,5,0,10,20,35,35,block.timestamp+1,address(r.f).codehash,address(r.p).codehash,address(r.a).codehash,address(r.b).codehash);r.b.setMode(MockToken.Mode.Fee,1);vm.expectRevert();onlyOutput.execute();require(!onlyOutput.used(),"recipient fee flag");unchanged(r);}
    function testReentrantTokenAndPoolCannotPersistPartialAction()external{Route memory r=route();r.a.setTarget(r.x);r.a.setMode(MockToken.Mode.Reenter,0);r.x.execute();require(r.a.reentryAttempted()&&r.x.used(),"token reentry guarded");r=route();r.p.setReenter(r.x);r.x.execute();require(r.p.poolReentryAttempted()&&r.x.used(),"pool reentry guarded");}
    function testFuzzExactRoute(uint96 donationA,uint96 donationB,uint96 donationLp)external{Route memory r=route();uint a=uint(donationA)%1e12;uint b=uint(donationB)%1e12;uint lp=uint(donationLp)%1e12;r.a.mint(address(r.x),a);r.b.mint(address(r.x),b);r.p.mint(address(r.x),lp);r.x.execute();require(r.a.b(address(r.x))==a&&r.b.b(address(r.x))==b&&r.p.b(address(r.x))==lp,"fuzz residue");}
    function testFixedForkBoundaryIsExact()external{if(!vm.envOr("BASE_BTC_HELPER_FORK",false))return;vm.createSelectFork(vm.envOr("BASE_BTC_HELPER_RPC",""),vm.envOr("BASE_BTC_HELPER_BLOCK",uint256(0)));require(block.number==50768614,"wrong block");require(block.timestamp==1788326575,"wrong timestamp");}
    function testFixtureDrivenRealRoute()external{if(!vm.envOr("BASE_BTC_HELPER_ROUTE",false))return;vm.createSelectFork(vm.envOr("BASE_BTC_HELPER_RPC",""),vm.envOr("BASE_BTC_HELPER_BLOCK",uint256(0)));address source=vm.envAddress("BASE_BTC_SOURCE");address recipient=vm.envAddress("BASE_BTC_RECIPIENT");IRealPool p=IRealPool(vm.envAddress("BASE_BTC_POOL"));address t0=p.token0();address t1=p.token1();uint loose0=IERC20(t0).balanceOf(source);uint loose1=IERC20(t1).balanceOf(source);IRealReward reward=IRealReward(vm.envAddress("BASE_BTC_REWARD_POOL"));IRealVault vault=IRealVault(vm.envAddress("BASE_BTC_VAULT"));uint staked=reward.balanceOf(source);vm.prank(source);reward.withdraw(staked);require(reward.balanceOf(source)==0,"reward zero");vm.prank(source);vault.withdrawAll();require(vault.balanceOf(source)==0,"vault zero");uint amount=p.balanceOf(source);require(amount>0,"exit lp");uint min0=IERC20(t0).balanceOf(address(p))*amount/p.totalSupply()*9950/10000;uint min1=IERC20(t1).balanceOf(address(p))*amount/p.totalSupply()*9950/10000;uint quote=p.getAmountOut(loose0+min0,t0);uint expectedTotal=loose1+IERC20(t1).balanceOf(address(p))*amount/p.totalSupply()+quote;StablePoolRecoveryExecutor x=new StablePoolRecoveryExecutor(source,recipient,p.factory(),address(p),t0,t1,p.stable(),amount,loose0,loose1,min0,min1,expectedTotal*9950/10000,expectedTotal*10050/10000,block.timestamp+1 days,p.factory().codehash,address(p).codehash,t0.codehash,t1.codehash);uint before=IERC20(t1).balanceOf(recipient);vm.prank(source);require(p.approve(address(x),amount),"lp approve");if(loose0!=0){vm.prank(source);require(IERC20(t0).approve(address(x),loose0),"tbtc approve");}if(loose1!=0){vm.prank(source);require(IERC20(t1).approve(address(x),loose1),"cbbtc approve");}vm.prank(source);x.execute();uint actual=IERC20(t1).balanceOf(recipient)-before;IRealMarket market=IRealMarket(vm.envAddress("BASE_BTC_MARKET"));uint debt=market.borrowBalanceCurrent(recipient);require(actual<=debt,"repay range");vm.prank(recipient);require(IERC20(t1).approve(address(market),actual),"market approve");vm.prank(recipient);require(market.repayBorrow(actual)==0,"repay");require(market.borrowBalanceStored(recipient)==debt-actual,"debt delta");MoonwellHealthAssertions health=new MoonwellHealthAssertions();health.assertMoonwellHealthFactors(recipient,0xfBb21d0380beE3312B33c4353c8936a0F13EF26C,0x10fF57877b79e9bd949B3815220eC87B9fc5D2ee,address(market));require(IERC20(t1).balanceOf(recipient)==before,"main loose cbbtc");require(IERC20(t1).allowance(recipient,address(market))==0,"main allowance zero");require(x.used(),"helper used");require(p.balanceOf(source)==0,"source lp zero");require(IERC20(t0).balanceOf(source)==0,"source tbtc zero");require(IERC20(t1).balanceOf(source)==0,"source cbbtc zero");}
}
