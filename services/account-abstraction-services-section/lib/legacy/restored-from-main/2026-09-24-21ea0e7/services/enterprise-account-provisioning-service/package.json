{
  "name": "@red-cup-engineering/enterprise-account-provisioning-service",
  "version": "0.2.0",
  "type": "module",
  "description": "Deterministic CREATE2 ERC-4337 enterprise-account provisioning with explicitly supplied signing custody.",
  "x-agentic-metro-enterprise": {
    "node-id": "enterprise-account-provisioning-service",
    "operation-catalog": {
      "solicit-service": {
        "accepts": "ActivityStreams Offer<ServiceSolicitation<EnterpriseAccountProvisioningDemand>>",
        "returns": "ActivityStreams Question<MissingProductionEnterpriseAccountCapability>|Reject<EnterpriseAccountProvisioningRefusal>"
      },
      "invoke-service": {
        "accepts": "ActivityStreams Accept<ServiceContract>",
        "returns": "ActivityStreams Question<MissingProductionEnterpriseAccountCapability>|Reject<EnterpriseAccountProvisioningRefusal>"
      }
    }
  },
  "bin": {
    "provision-enterprise-account": "./scripts/provision-enterprise-account.mjs",
    "bind-enterprise-account": "./scripts/bind-enterprise-account.mjs",
    "solicit-service": "./src/enterprise-account-provisioning-contract.mjs",
    "invoke-service": "./src/enterprise-account-provisioning-contract.mjs"
  },
  "exports": {
    "./provision": "./src/provision-enterprise-account.mjs",
    "./binding": "./src/account-binding.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/a2a-services-section": "0.9.0",
    "@red-cup-engineering/computer-code-engineering-services-section": "0.1.0",
    "@red-cup-engineering/javascript-node-services-section": "0.3.0",
    "@red-cup-engineering/uri-services-section": "0.1.0",
    "@red-cup-engineering/witness-journal-document-service": "0.1.0",
    "ethers": "6.17.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
